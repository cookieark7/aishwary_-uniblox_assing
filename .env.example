# Neon: use the DIRECT (non-pooled) connection string, i.e. host without "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
PORT=3000
# Separate database for `npm test` and `npm run db:setup:test`. It is wiped before every test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME_test?sslmode=require
