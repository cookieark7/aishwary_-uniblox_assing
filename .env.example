# Works as-is with the bundled Postgres: `docker compose up -d --wait`.
# Any other Postgres 13+ works too (local install, Neon, …) — just change the two URLs.
# For a hosted database add ?sslmode=require (Neon: use the direct, non-pooled host).
DATABASE_URL=postgresql://uniblox:uniblox@localhost:5433/uniblox_dev
PORT=3000
# Every Nth order unlocks one coupon (admin generates it) worth this percent off.
COUPON_EVERY_N_ORDERS=5
COUPON_PERCENT_OFF=10
# Separate database for `npm test` and `npm run db:setup:test`. It is wiped before every test.
TEST_DATABASE_URL=postgresql://uniblox:uniblox@localhost:5433/uniblox_test
